#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --output={{ logs_dir }}/{{ job_name }}.out
#SBATCH --error={{ logs_dir }}/{{ job_name }}.err
{{ sbatch_directives }}

# The code this task runs (its sweep's snapshot on a remote); pre_script may use it.
export HSM_CODE_DIR={{ project_dir }}
{% include "_module_init.sh.j2" %}
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
{% for line in pre_script %}
{{ line }}
{% endfor %}
{# conda-init AFTER modules + pre_script so a module-provided conda is on PATH
   first and the probe defers to it (never shadows it with micromamba). #}
{% include "_conda_init.sh.j2" %}

set -e

echo "Job started at: $(date)"
echo "Running on node: $(hostname)"

cd {{ project_dir }}
echo "Working directory: $(pwd)"

mkdir -p {{ task_dir }}
# One shell word, so the tokens' own quotes reach the eval below intact (a list value has
# a space, which would otherwise end COMMAND's string early).
PARAMS={{ params_hydra | shquote }}
echo "Job ID: ${SLURM_JOB_ID:-unknown}" > {{ task_dir }}/task_info.txt
echo "Node: $(hostname)" >> {{ task_dir }}/task_info.txt
echo "Parameters: $PARAMS" >> {{ task_dir }}/task_info.txt
echo "Started: $(date)" >> {{ task_dir }}/task_info.txt
# Self-describing artifact: the exact overrides for this task, so a synced
# checkpoint is never orphaned from its params (see Tier 2 of the field report).
cat > {{ task_dir }}/params.yaml <<'HSM_PARAMS_EOF'
{{ params_yaml }}HSM_PARAMS_EOF

COMMAND="{{ python_path }} {{ script_path }} $PARAMS {{ task_overrides(hydra_overrides, wandb_group or sweep_id, task_dir) }}"
echo "Executing: $COMMAND"
echo "$COMMAND" > {{ task_dir }}/command.txt

if eval "$COMMAND"; then
    echo "Completed: $(date)" >> {{ task_dir }}/task_info.txt
    echo "Status: SUCCESS" >> {{ task_dir }}/task_info.txt
else
    exit_code=$?
    echo "Failed: $(date)" >> {{ task_dir }}/task_info.txt
    echo "Status: FAILED" >> {{ task_dir }}/task_info.txt
    echo "Exit Code: $exit_code" >> {{ task_dir }}/task_info.txt
    exit $exit_code
fi
