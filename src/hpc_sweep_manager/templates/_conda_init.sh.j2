{# Shared conda / micromamba init block for non-interactive shells.

   Non-interactive sbatch + non-interactive SSH shells skip ~/.bashrc /
   ~/.zshrc, so `conda` is usually not on PATH and `MAMBA_EXE` is
   usually not set. This block probes the standard install locations,
   sources whatever it finds, and defines a `conda` bash function that
   delegates to `micromamba` on mamba-only systems — so the rest of the
   rendered script can always invoke `conda run -n <env> python ...`
   regardless of which package manager the user actually has.

   Caller-supplied context: requires `uses_conda` to be truthy to emit
   anything; emits a no-op when false (no conda env requested). With
   `conda_env`, the first install that has `envs/<conda_env>` wins (else the
   first install found, unless micromamba holds the env), so a leftover
   ~/miniconda3 can't shadow ~/miniforge3.
#}
{% if uses_conda %}
# --- HSM conda / micromamba init (non-interactive shells skip .bashrc) -------
_hsm_conda_loaded=0
# A real conda already on PATH wins — e.g. `module load miniforge3` ran in
# `pre_script` / `modules`, which now render BEFORE this block. NEVER shadow it
# with the micromamba bridge below: that would resolve a different env and
# silently drop GPU jobs to CPU (cuInit: CUDA_ERROR_NO_DEVICE). This also
# catches a module-provided conda whose prefix isn't in the fixed list below.
if command -v conda >/dev/null 2>&1; then
    _hsm_conda_loaded=1
fi
if [ "$_hsm_conda_loaded" -eq 0 ]; then
    _hsm_first="" _hsm_pick=""
    for _r in "${CONDA_EXE:+${CONDA_EXE%/bin/conda}}" "$HOME/miniconda3" "$HOME/anaconda3" \
             "$HOME/miniforge3" "$HOME/mambaforge" "$HOME/.miniconda3" "/opt/conda"; do
        [ -n "$_r" ] && [ -f "$_r/etc/profile.d/conda.sh" ] || continue
        _hsm_first="${_hsm_first:-$_r}"
{% if conda_env %}
        [ -d "$_r/envs/{{ conda_env }}/conda-meta" ] || continue
{% endif %}
        _hsm_pick="$_r"
        break
    done
{% if conda_env %}
    # An env in micromamba's root is left to the micromamba bridge below.
    [ -d "${MAMBA_ROOT_PREFIX:-$HOME/micromamba}/envs/{{ conda_env }}" ] && _hsm_first=""
{% endif %}
    _hsm_pick="${_hsm_pick:-$_hsm_first}"
    if [ -n "$_hsm_pick" ]; then
        # shellcheck disable=SC1091
        . "$_hsm_pick/etc/profile.d/conda.sh"
        _hsm_conda_loaded=1
    fi
fi
if [ "$_hsm_conda_loaded" -eq 0 ]; then
    # Conda not found; try micromamba. Probe MAMBA_EXE (if exported), then
    # common install locations. The last entry catches users who keep the
    # binary inside this repo's bin/ — Gabriel's S3IT layout.
    for _m in "${MAMBA_EXE:-}" \
             "$HOME/.local/bin/micromamba" \
             "$HOME/bin/micromamba" \
             "$HOME/micromamba/bin/micromamba" \
             "$HOME/mambaforge/bin/micromamba" \
             "/usr/local/bin/micromamba"; do
        if [ -n "$_m" ] && [ -x "$_m" ]; then
            export MAMBA_EXE="$_m"
            export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$HOME/micromamba}"
            # shellcheck disable=SC2046
            eval "$("$_m" shell hook --shell bash --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)"
            # Make `conda run -n <env> ...` work by routing it to micromamba.
            # This function is visible to `eval "$COMMAND"` later in the same shell.
            conda() { micromamba "$@"; }
            _hsm_conda_loaded=1
            break
        fi
    done
fi
if [ "$_hsm_conda_loaded" -eq 0 ]; then
    echo "warning: neither conda nor micromamba found in standard locations." >&2
    echo "         If \`conda run -n <env>\` fails below, install one or set" >&2
    echo "         MAMBA_EXE in your shell rc to point at the binary." >&2
fi
# ----------------------------------------------------------------------------
{% endif %}
