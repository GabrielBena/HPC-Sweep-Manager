#!/bin/bash
# Push-model SSHComputeSource wrapper for {{ job_name }} (job_id={{ job_id }}).
# Runs on the remote host inside the rsync'd code dir, detached (setsid nohup; the launch writes
# its pid to .hsm_pid): it outlives the launcher's connection. Its exit code lands in .hsm_rc,
# which one poll per cycle reads; a cancel TERMs its whole process group, which ends it with 143.
set -e
trap 'echo $? > {{ remote_task_dir }}/.hsm_rc' EXIT
trap 'exit 143' TERM

{% if cuda_visible_devices is not none %}
# HSM's GPU indices are nvidia-smi's (PCI order); CUDA's default is fastest-first.
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES={{ cuda_visible_devices }}
{% endif %}
# The code this task runs (its sweep's snapshot on a remote); pre_script may use it.
export HSM_CODE_DIR={{ remote_code_dir }}
{% include "_module_init.sh.j2" %}
{% for mod in modules %}
module load {{ mod }} 2>/dev/null || echo "warning: module load {{ mod }} failed" >&2
{% endfor %}
{% for line in pre_script %}
{{ line }}
{% endfor %}
{# conda-init AFTER modules + pre_script so a module-provided conda is on PATH
   first and the probe defers to it (never shadows it with micromamba). #}
{% include "_conda_init.sh.j2" %}

cd {{ remote_code_dir }}

mkdir -p {{ remote_task_dir }}
{
    echo "Job ID: {{ job_id }}"
    echo "Task: {{ job_name }}"
    echo "Node: $(hostname)"
    echo "Parameters: {{ params_hydra }}"
    echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES-<unset>}"
    echo "Started: $(date)"
} > {{ remote_task_dir }}/task_info.txt
# Self-describing artifact: the exact overrides for this task (Tier 2).
cat > {{ remote_task_dir }}/params.yaml <<'HSM_PARAMS_EOF'
{{ params_yaml }}HSM_PARAMS_EOF

COMMAND="{{ run_prefix }} {{ script_path }} {{ params_hydra }} wandb.group={{ wandb_group }} output.dir={{ remote_task_dir }}"
echo "$COMMAND" > {{ remote_task_dir }}/command.txt
echo "Executing: $COMMAND"

if eval "$COMMAND"; then
    {
        echo "Completed: $(date)"
        echo "Status: SUCCESS"
    } >> {{ remote_task_dir }}/task_info.txt
else
    exit_code=$?
    {
        echo "Failed: $(date)"
        echo "Status: FAILED"
        echo "Exit Code: $exit_code"
    } >> {{ remote_task_dir }}/task_info.txt
    exit $exit_code
fi
