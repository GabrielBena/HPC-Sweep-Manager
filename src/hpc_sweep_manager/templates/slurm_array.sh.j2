#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --array=1-{{ num_jobs }}
#SBATCH --output={{ logs_dir }}/{{ job_name }}_%A_%a.out
#SBATCH --error={{ logs_dir }}/{{ job_name }}_%A_%a.err
{{ sbatch_directives }}

{% for mod in modules %}
module load {{ mod }}
{% endfor %}
{% for line in pre_script %}
{{ line }}
{% endfor %}
{# conda-init AFTER modules + pre_script so a module-provided conda is on PATH
   first and the probe defers to it (never shadows it with micromamba). #}
{% include "_conda_init.sh.j2" %}

set -e

echo "Array job task: $SLURM_ARRAY_TASK_ID"
echo "Job started at: $(date)"
echo "Running on node: $(hostname)"

cd {{ project_dir }}
echo "Working directory: $(pwd)"

if [[ -z "$SLURM_ARRAY_TASK_ID" ]]; then
    echo "Error: SLURM_ARRAY_TASK_ID not set. This script should only run as part of an array job."
    exit 1
fi

PARAMS_FILE="{{ params_file }}"
if [[ ! -f "$PARAMS_FILE" ]]; then
    echo "Error: Parameter combinations file not found: $PARAMS_FILE"
    exit 1
fi

# Write the extraction snippet to a tempfile and run it BY PATH. Never feed a
# program over stdin into an interpreter prefix we don't control: python_path
# may be a wrapper (`conda run -n <env> python`), and `conda run` does not
# forward heredoc stdin to the subprocess inside $() on some clusters — the
# snippet then reads empty stdin, prints nothing, and exits 0, silently
# running the task with the project's DEFAULT config (field report 2026-06-03).
_HSM_PARAMS_SCRIPT=$(mktemp) || {
    echo "Error: mktemp failed (TMPDIR=${TMPDIR:-unset}) — cannot stage params extraction for array index $SLURM_ARRAY_TASK_ID"
    exit 1
}
# Backstop cleanup on every exit path (incl. set -e aborts); the explicit
# rm after extraction keeps /tmp tidy during long training runs.
trap 'rm -f "$_HSM_PARAMS_SCRIPT"' EXIT
cat > "$_HSM_PARAMS_SCRIPT" <<'PYTHON_EOF'
import json
import os
import sys

params_file = "{{ params_file }}"
array_index = int(os.environ['SLURM_ARRAY_TASK_ID'])

try:
    with open(params_file, 'r') as f:
        all_combinations = json.load(f)
    matching_combo = next(
        (c for c in all_combinations if c['index'] == array_index), None
    )
    if matching_combo is None:
        print(f"Error: No parameter combination found for index {array_index}", file=sys.stderr)
        sys.exit(1)
    global_index = matching_combo.get('global_index', array_index)
    params = matching_combo['params']
    # Self-describing artifact: drop the exact overrides next to the checkpoint
    # (Tier 2). JSON is valid YAML, so no PyYAML needed on the compute node.
    _task_dir = os.path.join("{{ tasks_dir }}", f"task_{global_index}")
    os.makedirs(_task_dir, exist_ok=True)
    with open(os.path.join(_task_dir, "params.yaml"), "w") as _pf:
        json.dump(params, _pf, indent=2, sort_keys=True)
        _pf.write("\n")
    tokens = []
    for k, v in params.items():
        if isinstance(v, (list, tuple)):
            tokens.append(f'"{k}={list(v)}"')
        elif v is None:
            tokens.append(f'"{k}=null"')
        elif isinstance(v, bool):
            tokens.append(f'"{k}={str(v).lower()}"')
        elif isinstance(v, str) and (' ' in v or ',' in v):
            tokens.append(f'"{k}={v}"')
        else:
            tokens.append(f'"{k}={v}"')
    print(f"{' '.join(tokens)}|{global_index}")
except Exception as e:
    print(f"Error processing parameters: {e}", file=sys.stderr)
    sys.exit(1)
PYTHON_EOF

# `|| { … }` (not a $?-check after the fact): the script runs under `set -e`,
# so a failing assignment would kill it before any later check could fire.
PARAMS_JSON=$({{ python_path }} "$_HSM_PARAMS_SCRIPT") || {
    echo "Error extracting parameters for array index $SLURM_ARRAY_TASK_ID"
    exit 1
}
rm -f "$_HSM_PARAMS_SCRIPT"

# Fail fast when extraction produced NOTHING (the B3 failure shape: wrapper
# swallowed the program, printed nothing, exited 0). Note: a legitimately
# empty params dict yields "|<index>" (non-empty) and is allowed through —
# baseline sweeps with zero overrides run identically in the other modes.
if [[ -z "$PARAMS_JSON" ]]; then
    echo "Error: empty parameter set for array index $SLURM_ARRAY_TASK_ID — refusing to run the default config"
    exit 1
fi

# Split on the LAST '|': override VALUES may contain pipes (regexes,
# choice strings); the trailing global index never does. Then require the
# index to be numeric — catches corrupted/partial extraction output that
# the emptiness check above can't see.
GLOBAL_INDEX="${PARAMS_JSON##*|}"
PARAMS_JSON="${PARAMS_JSON%|*}"
if ! [[ "$GLOBAL_INDEX" =~ ^[0-9]+$ ]]; then
    echo "Error: malformed parameter extraction output for array index $SLURM_ARRAY_TASK_ID (global index: '$GLOBAL_INDEX')"
    exit 1
fi
echo "Parameters: $PARAMS_JSON"
echo "Global task index: $GLOBAL_INDEX"

TASK_OUTPUT_DIR="{{ tasks_dir }}/task_${GLOBAL_INDEX}"

if [[ -f "$TASK_OUTPUT_DIR/task_info.txt" ]]; then
    if grep -q "Status: SUCCESS" "$TASK_OUTPUT_DIR/task_info.txt" 2>/dev/null \
        || grep -q "Status: COMPLETED" "$TASK_OUTPUT_DIR/task_info.txt" 2>/dev/null; then
        echo "WARNING: Task $GLOBAL_INDEX is already COMPLETED. Skipping."
        exit 0
    fi
fi

mkdir -p "$TASK_OUTPUT_DIR"

echo "Slurm Array Index: $SLURM_ARRAY_TASK_ID" > "$TASK_OUTPUT_DIR/task_info.txt"
echo "Global Task Index: $GLOBAL_INDEX" >> "$TASK_OUTPUT_DIR/task_info.txt"
{% if gpu_type %}
{# Assigned by the multi-gpu_type planner — cross-arch numerics differ, so
   analyses must be able to check for arch confounds per task. #}
echo "GPU Type: {{ gpu_type }}" >> "$TASK_OUTPUT_DIR/task_info.txt"
{% endif %}
echo "Parameters: $PARAMS_JSON" >> "$TASK_OUTPUT_DIR/task_info.txt"
echo "Started: $(date)" >> "$TASK_OUTPUT_DIR/task_info.txt"
echo "Node: $(hostname)" >> "$TASK_OUTPUT_DIR/task_info.txt"

{% if wandb_group %}
WANDB_GROUP="{{ wandb_group }}"
{% else %}
WANDB_GROUP="{{ sweep_id }}"
{% endif %}

COMMAND="{{ python_path }} {{ script_path }} $PARAMS_JSON wandb.group=$WANDB_GROUP output.dir=$TASK_OUTPUT_DIR"
echo "Executing: $COMMAND"
echo "$COMMAND" > "$TASK_OUTPUT_DIR/command.txt"

if eval "$COMMAND"; then
    echo "Completed: $(date)" >> "$TASK_OUTPUT_DIR/task_info.txt"
    echo "Status: SUCCESS" >> "$TASK_OUTPUT_DIR/task_info.txt"
else
    exit_code=$?
    echo "Failed: $(date)" >> "$TASK_OUTPUT_DIR/task_info.txt"
    echo "Status: FAILED" >> "$TASK_OUTPUT_DIR/task_info.txt"
    echo "Exit Code: $exit_code" >> "$TASK_OUTPUT_DIR/task_info.txt"
    exit $exit_code
fi
