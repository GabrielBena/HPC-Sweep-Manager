#!/usr/bin/env python3
"""Fake scancel: marks the targeted jobs as CANCELLED in jobs.jsonl.

Each call's arguments are appended to ``scancel.log`` (one line per call). Like real Slurm with
the default signal, an unknown or ended job id is no error; ``HSM_FAKE_SCANCEL_RC`` forces a
failure.
"""

from __future__ import annotations

import json
import os
import sys


def main() -> int:
    state_dir = os.environ.get("HSM_FAKE_STATE_DIR")
    if not state_dir:
        print("HSM_FAKE_STATE_DIR not set", file=sys.stderr)
        return 1

    if len(sys.argv) < 2:
        print("scancel: missing job id", file=sys.stderr)
        return 1
    targets = set(sys.argv[1:])
    with open(os.path.join(state_dir, "scancel.log"), "a") as f:
        f.write(" ".join(sys.argv[1:]) + "\n")

    state_path = os.path.join(state_dir, "jobs.jsonl")
    if not os.path.exists(state_path):
        return 0  # Nothing to cancel; treat as no-op success.

    jobs: list[dict] = []
    with open(state_path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            jobs.append(json.loads(line))

    found = set()
    for j in jobs:
        if j["id"] in targets:
            j["state"] = "CANCELLED"
            found.add(j["id"])

    with open(state_path, "w") as f:
        for j in jobs:
            f.write(json.dumps(j) + "\n")

    rc = int(os.environ.get("HSM_FAKE_SCANCEL_RC", "0"))
    if rc:
        print("scancel: error: Unable to contact slurm controller", file=sys.stderr)
    return rc


if __name__ == "__main__":
    sys.exit(main())
